intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
#import xxxx_libs += libhello%lib{hello}

lib{metrohash}: libul{metrohash}: hxx{**} cxx{** -metrohash128crc} \
                                  $impl_libs $intf_libs

# The CRC variants (metrohash128crc_*()) use the SSE4.2 CRC32 instruction and
# are only built for x86_64.
#
x86_64 = ($cxx.target.cpu == 'x86_64')

libul{metrohash}: cxx{metrohash128crc}: include = $x86_64

libs{metrohash}: def{metrohash}: include = ($cxx.target.system == 'win32-msvc')
def{metrohash}: libul{metrohash}

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# GCC and Clang only make the SSE4.2 intrinsics available with -msse4.2
# (MSVC makes them available unconditionally). Enable it for the CRC
# variants translation unit only so that the rest of the library does not
# require SSE4.2.
#
if ($x86_64 && ($cxx.class == 'gcc' || $cxx.id == 'msvc-clang'))
  obj{metrohash128crc}: cxx.coptions += -msse4.2

# Export options.
#
lib{metrohash}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $intf_libs
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{metrohash}: bin.lib.version = "-$version.project_id"
else
  lib{metrohash}: bin.lib.version = "-$version.major.$version.minor"

# Install into the metrohash/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
hxx{*}:
{
  install         = include/metrohash/
  install.subdirs = true
}

# Don't install private headers.
#
hxx{platform}@./: install = false
